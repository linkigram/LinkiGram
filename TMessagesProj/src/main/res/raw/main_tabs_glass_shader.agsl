uniform shader img;
uniform float2 center;
uniform float2 size;
uniform float4 radius;
uniform float thickness;
uniform float refract_index;
uniform float refract_intensity;
uniform float4 foreground_color_premultiplied;
uniform float2 resolution;
uniform float light_position;
uniform float press_progress;

float distanceToEdge(float2 p) {
    float2 corners = p.x > 0.0 ? radius.xy : radius.zw;
    float r = p.y > 0.0 ? corners.x : corners.y;
    float2 q = abs(p) - size + r;
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}

float surfaceHeight(float t) {
    float s = 1.0 - t;
    return pow(max(1.0 - s * s * s * s, 0.0), 0.25);
}

half4 main(float2 coord) {
    float2 p = coord - center;
    float distance = distanceToEdge(p);
    float depth = max(-distance, 0.0);
    float bezel = max(thickness, 0.5);
    float t = clamp(depth / bezel, 0.0, 1.0);
    float h = surfaceHeight(t);
    float derivative = (surfaceHeight(min(t + 0.001, 1.0)) - h) / 0.001;
    float opticalThickness = bezel * 0.83;
    float slope = derivative * opticalThickness / bezel;
    float angle = asin(sin(atan(slope)) / max(refract_index, 1.0));
    float displacement = min(h * opticalThickness * (slope - tan(angle)), bezel * 1.5);
    float2 gradient = float2(distanceToEdge(p + float2(0.5, 0.0)) - distance,
                             distanceToEdge(p + float2(0.0, 0.5)) - distance);
    float2 normal = gradient / max(length(gradient), 0.0001);
    float2 low = float2(0.5);
    float2 high = max(low, resolution - 0.5);
    float2 samplePoint = clamp(coord - normal * displacement * refract_intensity, low, high);
    float4 backdrop = float4(img.eval(samplePoint));
    float3 color = backdrop.rgb / max(backdrop.a, 0.0001);
    float rim = abs(dot(normal, normalize(float2(0.5 + (light_position - 0.5) * 0.8, -0.7))));
    float rimFalloff = 1.0 - smoothstep(0.0, bezel * 0.4, depth);
    float innerShadow = 1.0 - smoothstep(0.0, bezel * 0.6, depth);
    float innerRim = smoothstep(0.0, bezel * 0.08, depth)
        * (1.0 - smoothstep(bezel * 0.08, bezel * 0.20, depth));
    color += pow(rim * rimFalloff, 1.5) * (0.55 + 0.15 * press_progress);
    color *= 1.0 - innerShadow * 0.09;
    color += innerRim * 0.0825;
    color = mix(color, float3(1.0), 0.08);

    float4 glass = float4(clamp(color, 0.0, 1.0) * backdrop.a, backdrop.a);
    float4 tint = foreground_color_premultiplied;
    return half4(tint + glass * (1.0 - tint.a));
}
