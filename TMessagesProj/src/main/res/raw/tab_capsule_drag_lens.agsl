uniform shader img;
uniform float2 center;
uniform float2 half_size;
uniform float2 scene_size;
uniform float density;
uniform float lift;
uniform float dark_theme;

float capsuleDistance(float2 point, float radius) {
    float2 axis = max(half_size - radius, 0.0);
    return length(point - clamp(point, -axis, axis)) - radius;
}

float4 backdropAt(float2 point) {
    return float4(img.eval(clamp(point, float2(0.5), scene_size - 0.5)));
}

half4 main(float2 coord) {
    float2 point = coord - center;
    float radius = min(half_size.x, half_size.y);
    float2 axis = max(half_size - radius, 0.0);
    float2 radial = point - clamp(point, -axis, axis);
    float radialLength = length(radial);
    float distance = capsuleDistance(point, radius);
    if (distance > 0.75) {
        // Short contact shadow. Its falloff and offset grow with the lens lift.
        float shadowDistance = max(0.0, capsuleDistance(point - float2(0.0, 2.0 * density * lift), radius));
        float reach = max(density * (1.0 + 3.5 * lift), 1.0);
        float shadow = exp(-shadowDistance * shadowDistance / (reach * reach));
        return half4(0.0, 0.0, 0.0, shadow * 0.18 * lift);
    }

    float coverage = 1.0 - smoothstep(-0.75, 0.75, distance);
    float depth = max(-distance, 0.0);
    float bezel = max(1.0, min(radius * 0.68, 14.0 * density));
    float edge = 1.0 - clamp(depth / bezel, 0.0, 1.0);
    float2 outward = radial / max(radialLength, 0.001);

    // The rounded slab samples further inside the shape at its rim. A convex
    // centre magnifies continuously into that bevel, without clamping to the pill.
    float bend = bezel * (0.18 + 0.22 * lift) * edge * edge;
    float2 samplePoint = center + point * (1.0 - 0.12 * lift) - outward * bend;
    float dispersion = min(bend * 0.055, 0.65 * density);
    float4 sceneColor = backdropAt(samplePoint);
    float4 redSample = backdropAt(samplePoint - outward * dispersion);
    float4 blueSample = backdropAt(samplePoint + outward * dispersion);
    float3 color = float3(redSample.r / max(redSample.a, 0.001),
        sceneColor.g / max(sceneColor.a, 0.001), blueSample.b / max(blueSample.a, 0.001));

    // Very small, symmetric sampling footprint. Refraction above operates on
    // coordinates; this only softens the lifted centre enough to separate it.
    float soft = density * (0.55 + 0.65 * lift) * (1.0 - 0.55 * edge);
    float4 surroundings = (backdropAt(samplePoint + float2(soft, 0.0))
        + backdropAt(samplePoint - float2(soft, 0.0))
        + backdropAt(samplePoint + float2(0.0, soft))
        + backdropAt(samplePoint - float2(0.0, soft))) * 0.25;
    color = mix(color, surroundings.rgb / max(surroundings.a, 0.001), 0.23);

    // Round-slab normal and Schlick Fresnel reflectance. The bevel responds
    // to the light direction and to the captured scene's luminance.
    float normalZ = sqrt(max(1.0 - edge * edge, 0.0));
    float3 surfaceNormal = float3(outward * edge, normalZ);
    float fresnel = 0.04 + 0.96 * pow(1.0 - normalZ, 5.0);
    float3 light = normalize(float3(-0.57, -0.74, 0.37));
    float3 halfVector = normalize(light + float3(0.0, 0.0, 1.0));
    float specular = pow(max(dot(surfaceNormal, halfVector), 0.0), 18.0);
    float luminance = dot(color, float3(0.2126, 0.7152, 0.0722));
    float3 tint = mix(float3(1.0), float3(0.12, 0.13, 0.15), dark_theme);
    float tintWeight = mix(0.06 + 0.08 * (1.0 - luminance), 0.08 + 0.12 * luminance, dark_theme);
    color = mix(color, tint, tintWeight);
    color *= 1.0 - fresnel * (0.07 + 0.13 * luminance);
    color += (1.0 - color) * specular * (0.20 + 0.13 * lift) * edge;

    float alpha = sceneColor.a * coverage * lift;
    return half4(clamp(color, 0.0, 1.0) * alpha, alpha);
}
